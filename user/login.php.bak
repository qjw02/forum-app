<?php

define('IN_API',true);

require_once '/www/wwwroot/qq/wwwroot/source/class/class_core.php';
require_once '/www/wwwroot/qq/wwwroot/source/function/function_member.php';


C::app()->init();


header('Content-Type: application/json; charset=utf-8');


$username=trim($_POST['username'] ?? '');

$password=$_POST['password'] ?? '';



if(!$username || !$password){

    echo json_encode([
        'code'=>400,
        'message'=>'账号密码不能为空'
    ],JSON_UNESCAPED_UNICODE);

    exit;

}



/*
 * 调用 Discuz X3.4 登录函数
 */

$result=userlogin(
    $username,
    $password,
    0,
    '',
    'username'
);



if($result['status'] != 1){

    echo json_encode([
        'code'=>401,
        'message'=>'账号或密码错误'
    ],JSON_UNESCAPED_UNICODE);

    exit;

}



$uid=intval($result['ucresult']['uid'] ?? 0);



if(!$uid){

    $member=DB::fetch_first(
        "SELECT uid,username
         FROM pre_common_member
         WHERE username=%s",
         array($username)
    );

    $uid=intval($member['uid']);

}



$member=getuserbyuid($uid,1);



/*
 * 删除旧token
 */

DB::query(
"DELETE FROM pre_app_token WHERE uid=%d",
array($uid)
);



/*
 * 生成token
 */

$token=sha1(
    $uid.
    $username.
    TIMESTAMP.
    mt_rand()
);


$expire=TIMESTAMP+86400*30;



DB::insert(
'app_token',
array(
    'uid'=>$uid,
    'token'=>$token,
    'expire'=>$expire
)
);



echo json_encode([

'code'=>0,

'message'=>'登录成功',

'data'=>array(

    'uid'=>$uid,

    'username'=>$member['username'],

    'avatar'=>
    'https://a3x9r3.cdlf3.com/uc_server/avatar.php?uid='.$uid.'&size=middle',

    'token'=>$token,

    'expire'=>$expire

)

],JSON_UNESCAPED_UNICODE);
